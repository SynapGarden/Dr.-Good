# Copy to .env and fill in. Never commit .env.
# Stages A, B and E need no keys at all.

# Stage C — NVIDIA BioNeMo hosted NIMs (MolMIM / GenMol, DiffDock, Boltz-2).
# Free key from https://build.nvidia.com/
NGC_API_KEY=

